# Copiar este archivo a ".env" (sin el ".example") y completar los valores reales.
# El ".env" real NUNCA se sube al repositorio (ya está en .gitignore).

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgres://usuario:password@localhost:5432/biblios

# Puerto donde escucha la API
PORT=3001

# Secreto para firmar los JWT de sesión. Generar uno propio y random en
# producción (por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=CAMBIAR_ESTO_EN_PRODUCCION
